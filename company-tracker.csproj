<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>company_tracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="./ReactApp/dist/**" CopyToOutputDirectory="PreserveNewest">
      <TargetPath>dist/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <Target Name="BuildReactApp" BeforeTargets="BeforeBuild">
    <Exec Command="pnpm build" WorkingDirectory="$(MSBuildProjectDirectory)/ReactApp" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Vite.AspNetCore" Version="2.4.1" />
  </ItemGroup>
</Project>
